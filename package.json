{
  "name": "folklore-horror-studio",
  "productName": "Folklore Horror Studio",
  "version": "0.1.0",
  "private": true,
  "description": "Ứng dụng desktop sản xuất video kể chuyện kinh dị dân gian Việt Nam & Đông Nam Á",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "vitest run --config vitest.smoke.config.ts",
    "bundle:remotion": "node scripts/bundle-remotion.mjs",
    "dist": "npm run build && npm run bundle:remotion && electron-builder --win --x64",
    "dist:dir": "npm run build && npm run bundle:remotion && electron-builder --win --x64 --dir"
  },
  "dependencies": {
    "@google/genai": "^1.52.0",
    "@remotion/bundler": "4.0.539",
    "@remotion/player": "4.0.539",
    "@remotion/renderer": "4.0.539",
    "electron-store": "^8.2.0",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "onnxruntime-node": "^1.31.1",
    "p-queue": "^6.6.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.539",
    "sharp": "^0.34.5",
    "zod": "^3.25.76",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "electron": "37.10.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^4.0.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vitest": "^3.2.4"
  },
  "author": "Folklore Horror Studio"
}
